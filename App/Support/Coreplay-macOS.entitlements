<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Files the user opens (Open panel, Finder, drag and drop). -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Folders added as library sources survive relaunch (Milestone 3). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- The Music and Movies folders, offered as default sources. -->
	<key>com.apple.security.assets.music.read-only</key>
	<true/>
	<key>com.apple.security.assets.movies.read-only</key>
	<true/>
	<!-- Snapshots from the video player go to Pictures ▸ Coreplay. -->
	<key>com.apple.security.assets.pictures.read-write</key>
	<true/>
	<!-- Streams, network shares and (opt-in) metadata lookups. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- UPnP discovery listens for servers' replies, and a Chromecast pulls
	     the video from a small server VLC runs while casting. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
