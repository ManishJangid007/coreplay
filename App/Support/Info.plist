<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Keys that build settings can't express. Xcode merges this file with the
	generated Info.plist (GENERATE_INFOPLIST_FILE = YES). Shared by the iOS and
	macOS builds of the single multiplatform target; each platform ignores the
	other's keys.
	-->

	<!-- iOS: keep playing audio in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- iPadOS: one window for now. Player presentation state is app-wide, so a
	     second window would present the player twice and fight over the video view.
	     Revisit with per-scene state (Milestone 5). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- Plain-HTTP media URLs (internet radio, home servers) may play with AVFoundation. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>

	<!-- Shown before reaching devices on the local network (streams, cameras, shares). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Coreplay plays streams and shared folders from devices on your network.</string>

	<!-- iOS: show Documents in Files ("On My iPhone ▸ Coreplay") and Finder file sharing,
	     and open files in place instead of copying them into an Inbox. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- coreplay://open?url=<percent-encoded URL> plays a stream or file. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Coreplay URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>coreplay</string>
			</array>
		</dict>
	</array>

